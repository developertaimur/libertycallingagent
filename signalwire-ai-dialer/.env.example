# Copy to .env and fill in real values. Never commit .env.

SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=your-space.signalwire.com
SIGNALWIRE_NUMBER=+1XXXXXXXXXX
# Real expert cell/desk numbers (do NOT reuse SIGNALWIRE_NUMBER)
HUMAN_TRANSFER_NUMBER=+1XXXXXXXXXX
HUMAN_TRANSFER_WEBSITE=+1XXXXXXXXXX
HUMAN_TRANSFER_MARKETING=+1XXXXXXXXXX
TRANSFER_RING_SECONDS=25
# Ring expert phone + whisper summary on answer; SMS handoff text
TRANSFER_WHISPER_ENABLED=true
TRANSFER_SEND_SMS_SUMMARY=true

# Public HTTPS base URL for webhooks (ngrok or production host, no trailing slash)
# No trailing slash. Must be the live Cloudflare/ngrok public HTTPS URL.
SERVER_HOST_URL=https://YOUR-SUBDOMAIN.trycloudflare.com

# Path to Google service-account JSON (relative to project root or absolute)
GOOGLE_SHEETS_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=
# Sheet headers expected (row 1): lead_id, name, phone, service_type, status,
# call_sid, call_received, interest_level, recording_url, summary,
# business_name, location, website_url, pain_point, decision_maker_role,
# preferred_email, industry (discovery columns auto-created if missing)
# Status value for queue: Pending

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Streaming voice pipeline (Deepgram Nova-2 STT + Cartesia Sonic TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=a0e1205c-ed01-4186-a0e5-d0e325112376
CARTESIA_MODEL_ID=sonic-turbo
USE_STREAMING_VOICE=false
