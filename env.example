# Copy to .env and fill in your API token. Never commit .env.

SIGNALWIRE_PROJECT_ID=0f38a445-6476-46f0-88ee-c4d45b870955
SIGNALWIRE_API_TOKEN=PT_your_api_token_here
SIGNALWIRE_SPACE_URL=scalify-agency.signalwire.com

# Must be a number you purchased in SignalWire
FROM_NUMBER=+12058312540

# AI agent "Jessica" SIP endpoint
# Option 2: create a SignalWire resource that loads SWML from your ngrok URL
# (with basic auth), then paste that resource's SIP address here.
AGENT_SIP=sip:dd21115e-566d-4f4c-888a-c0bfd4d38052@0f38a445-6476-46f0-88ee-c4d45b870955.call.signalwire.com;context=guest

# TEST_MODE=true sends EVERY call to TEST_NUMBER. Set to false only after testing.
TEST_MODE=true
TEST_NUMBER=+17869848504

# Call settings
RECORD_CALLS=true
RING_TIMEOUT=30

# Optional: public HTTPS URL for call status webhooks (leave empty for now)
STATUS_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Local Jessica agent (Option 2 — Agents SDK)
# ---------------------------------------------------------------------------
AGENT_PORT=3000
AGENT_HOST=0.0.0.0
# Female default for Jessica. Fallbacks: deepgram.aura-asteria-en,
# deepgram.aura-perseus-en, deepgram.aura-angus-en, deepgram.aura-arcas-en
AGENT_VOICE=deepgram.aura-luna-en

# REQUIRED — refuse to start agent if empty. Use strong random values.
SWML_BASIC_AUTH_USER=scalify
SWML_BASIC_AUTH_PASSWORD=change_me_to_a_long_random_secret

# Public URL from `ngrok http 3000` (no trailing slash)
SWML_PROXY_URL_BASE=

# SQLite path (default: data/scalify.db)
DATABASE_PATH=

# Compliance / SMS
A2P_10DLC_REGISTERED=false
MAX_CALL_ATTEMPTS=3
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=19
ALLOW_SUNDAY_CALLS=false
CALENDAR_PROVIDER=stub
SMS_PROVIDER=stub
